{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:subtitle-assistant:tool:v1",
  "title": "Subtitle Assistant API 1.1 / storage schema 2 contracts",
  "description": "Implemented model-free M2 CLI and loopback HTTP contracts. The root validates response envelopes; use $defs/OperationRequest for HTTP inputs and the named argument definitions for CLI JSON request files. Runtime checks revision/hash equality, exact unit membership, SRT structure, markup scope and semantic mapping beyond this structural schema.",
  "oneOf": [
    {
      "$ref": "#/$defs/Success"
    },
    {
      "$ref": "#/$defs/Failure"
    }
  ],
  "$defs": {
    "Uuid": {
      "type": "string",
      "format": "uuid"
    },
    "Revision": {
      "type": "integer",
      "minimum": 0
    },
    "Milliseconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "Diagnostic": {
      "type": "object",
      "required": [
        "code",
        "severity",
        "block",
        "line",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "warning",
            "error"
          ]
        },
        "block": {
          "type": "integer",
          "minimum": 0
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Project": {
      "type": "object",
      "required": [
        "project_id",
        "name",
        "revision",
        "context_revision",
        "source_language",
        "target_language",
        "source_path",
        "source_sha256",
        "source_encoding",
        "source_newline",
        "source_byte_count",
        "entry_count",
        "created_at"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^prj_[a-f0-9]{32}$"
        },
        "name": {
          "type": "string"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "context_revision": {
          "$ref": "#/$defs/Revision"
        },
        "source_language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "target_language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "source_path": {
          "type": "string"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_encoding": {
          "type": "string"
        },
        "source_newline": {
          "enum": [
            "LF",
            "CRLF",
            "CR",
            "mixed"
          ]
        },
        "source_byte_count": {
          "type": "integer",
          "minimum": 0
        },
        "entry_count": {
          "type": "integer",
          "minimum": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "ProjectId": {
      "type": "string",
      "pattern": "^prj_[a-f0-9]{32}$"
    },
    "EntryId": {
      "type": "string",
      "pattern": "^prj_[a-f0-9]{32}:entry:[0-9]{6,}$"
    },
    "BatchId": {
      "type": "string",
      "pattern": "^batch_[a-f0-9]{32}$"
    },
    "ChangeId": {
      "type": "string",
      "pattern": "^change_[a-f0-9]{32}$"
    },
    "SourceHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "\\S",
      "description": "An attribution label, not an authentication or tool-authority claim."
    },
    "TranslationState": {
      "enum": [
        "untranslated",
        "draft",
        "translated",
        "intentionally_preserved",
        "needs_review"
      ]
    },
    "SubmittedState": {
      "enum": [
        "draft",
        "translated",
        "intentionally_preserved",
        "needs_review"
      ]
    },
    "ReviewState": {
      "enum": [
        "unchecked",
        "agent_reviewed",
        "human_reviewed"
      ]
    },
    "JobState": {
      "enum": [
        "pending",
        "running",
        "pause_requested",
        "paused",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "ActivityPhase": {
      "enum": [
        "starting",
        "analyzing",
        "translating",
        "validating",
        "waiting",
        "paused",
        "finished",
        "failed"
      ]
    },
    "Error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "details"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "Success": {
      "type": "object",
      "required": [
        "ok",
        "api_version",
        "request_id",
        "data",
        "warnings"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "api_version": {
          "const": "1.1"
        },
        "request_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "data": {
          "type": "object"
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Diagnostic"
          }
        }
      },
      "additionalProperties": false,
      "description": "CLI and HTTP success envelope. data depends on the operation; mutation data also includes replayed. Source diagnostics are in warnings; semantic review notes remain inside data."
    },
    "Failure": {
      "type": "object",
      "required": [
        "ok",
        "api_version",
        "request_id",
        "error",
        "warnings"
      ],
      "properties": {
        "ok": {
          "const": false
        },
        "api_version": {
          "const": "1.1"
        },
        "request_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "$ref": "#/$defs/Error"
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Diagnostic"
          }
        }
      },
      "additionalProperties": false,
      "description": "A request_id can be null if rejection precedes mutation UUID normalization. A valid receipt, rather than transport success alone, resolves an uncertain write."
    },
    "Target": {
      "type": "object",
      "required": [
        "text",
        "state",
        "review_state",
        "protected"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "$ref": "#/$defs/SubmittedState"
        },
        "review_state": {
          "$ref": "#/$defs/ReviewState"
        },
        "protected": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        }
      },
      "additionalProperties": false
    },
    "Entry": {
      "type": "object",
      "required": [
        "entry_id",
        "ordinal",
        "source_index",
        "source_line",
        "source_text",
        "start_ms",
        "end_ms",
        "source_revision",
        "timing_revision"
      ],
      "properties": {
        "entry_id": {
          "type": "string",
          "pattern": "^prj_[a-f0-9]{32}:entry:[0-9]{6,}$"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "source_index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "source_line": {
          "type": "integer",
          "minimum": 1
        },
        "source_text": {
          "type": "string",
          "minLength": 1
        },
        "start_ms": {
          "$ref": "#/$defs/Milliseconds"
        },
        "end_ms": {
          "$ref": "#/$defs/Milliseconds"
        },
        "source_revision": {
          "$ref": "#/$defs/Revision"
        },
        "timing_revision": {
          "$ref": "#/$defs/Revision"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/Target"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "description": "entry.list item: source_line is retained. Schema-2 workspaces add target (null until translated); protected is the SQLite-backed wire integer 0/1."
    },
    "PublicEntry": {
      "type": "object",
      "required": [
        "entry_id",
        "ordinal",
        "source_index",
        "source_text",
        "start_ms",
        "end_ms",
        "source_revision",
        "timing_revision",
        "target_text",
        "translation_state",
        "review_state",
        "protected"
      ],
      "properties": {
        "entry_id": {
          "type": "string",
          "pattern": "^prj_[a-f0-9]{32}:entry:[0-9]{6,}$"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "source_index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "source_text": {
          "type": "string",
          "minLength": 1
        },
        "start_ms": {
          "$ref": "#/$defs/Milliseconds"
        },
        "end_ms": {
          "$ref": "#/$defs/Milliseconds"
        },
        "source_revision": {
          "$ref": "#/$defs/Revision"
        },
        "timing_revision": {
          "$ref": "#/$defs/Revision"
        },
        "target_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "translation_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/SubmittedState"
            },
            {
              "type": "null"
            }
          ]
        },
        "review_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReviewState"
            },
            {
              "type": "null"
            }
          ]
        },
        "protected": {
          "type": [
            "integer",
            "null"
          ],
          "enum": [
            0,
            1,
            null
          ]
        }
      },
      "additionalProperties": false,
      "description": "Flattened entry snapshot used in batches and entry.edit/restore results. Unlike entry.list, it has no source_line or nested target."
    },
    "EmptyArguments": {
      "type": "object",
      "required": [],
      "properties": {},
      "additionalProperties": false
    },
    "ProjectArguments": {
      "type": "object",
      "required": [
        "project_id"
      ],
      "properties": {
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        }
      },
      "additionalProperties": false
    },
    "PageArguments": {
      "type": "object",
      "required": [],
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 50
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "ProjectPageArguments": {
      "type": "object",
      "required": [
        "project_id"
      ],
      "properties": {
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 50
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "ImportArguments": {
      "type": "object",
      "required": [
        "input_path"
      ],
      "properties": {
        "input_path": {
          "type": "string",
          "minLength": 1
        },
        "source_language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "default": "en"
        },
        "target_language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "default": "hu"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "encoding": {
          "type": [
            "string",
            "null"
          ]
        },
        "request_id": {
          "$ref": "#/$defs/MutationRequestId"
        }
      },
      "additionalProperties": false
    },
    "InspectArguments": {
      "type": "object",
      "required": [
        "input_path"
      ],
      "properties": {
        "input_path": {
          "type": "string",
          "minLength": 1
        },
        "encoding": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "ExportArguments": {
      "type": "object",
      "required": [
        "project_id",
        "output_path"
      ],
      "properties": {
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "output_path": {
          "type": "string",
          "minLength": 1
        },
        "variant": {
          "enum": [
            "source",
            "original",
            "target",
            "draft"
          ],
          "default": "source"
        },
        "expected_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/Revision"
            },
            {
              "type": "null"
            }
          ]
        },
        "request_id": {
          "$ref": "#/$defs/MutationRequestId"
        }
      },
      "additionalProperties": false,
      "description": "A new output path is required; imported source overwrite is refused. source preserves working text/anchors, original restores archived bytes, target requires a complete reviewed mapping, and draft allows partial work with visible review markers, source fallbacks and a pending-cue report. Every variant preserves SRT structure and timing anchors."
    },
    "ReceiptArguments": {
      "type": "object",
      "required": [
        "request_id"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/Uuid"
        }
      },
      "additionalProperties": false
    },
    "MigrationArguments": {
      "type": "object",
      "required": [],
      "properties": {
        "expected_version": {
          "const": 1,
          "default": 1
        }
      },
      "additionalProperties": false,
      "description": "Explicit schema-1 to schema-2 migration creates a verified local backup. This operation has no request UUID receipt; repeat on an already-current workspace reports migrated=false."
    },
    "BatchPrepareArguments": {
      "type": "object",
      "required": [
        "project_id",
        "expected_project_revision"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/MutationRequestId"
        },
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "expected_project_revision": {
          "$ref": "#/$defs/Revision"
        },
        "max_chars": {
          "type": "integer",
          "minimum": 100,
          "maximum": 50000,
          "default": 6000
        },
        "context_before": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "default": 2
        },
        "context_after": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10,
          "default": 2
        },
        "actor": {
          "$ref": "#/$defs/Actor"
        }
      },
      "additionalProperties": false,
      "description": "Select whole semantic translation units under the source-character budget. Unit boundaries are never cut to fill the budget. Read-only context entries may occur outside writable_entry_ids."
    },
    "BatchGetArguments": {
      "type": "object",
      "required": [
        "batch_id"
      ],
      "properties": {
        "batch_id": {
          "$ref": "#/$defs/BatchId"
        }
      },
      "additionalProperties": false
    },
    "TranslatedEntry": {
      "type": "object",
      "required": [
        "entry_id",
        "text",
        "state",
        "review_state"
      ],
      "properties": {
        "entry_id": {
          "$ref": "#/$defs/EntryId"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "$ref": "#/$defs/SubmittedState"
        },
        "review_state": {
          "$ref": "#/$defs/ReviewState"
        }
      },
      "additionalProperties": false,
      "description": "One timed entry of a translation unit. Final states require agent_reviewed or human_reviewed; runtime validates formatting, voice/accessibility markers and the stable cue mapping."
    },
    "TranslatedUnit": {
      "type": "object",
      "required": [
        "unit_id",
        "entries"
      ],
      "properties": {
        "unit_id": {
          "type": "string",
          "pattern": "^unit_[a-f0-9]{24}$"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TranslatedEntry"
          }
        }
      },
      "additionalProperties": false
    },
    "BatchSubmitArguments": {
      "type": "object",
      "required": [
        "batch_id",
        "expected_project_revision",
        "source_sha256",
        "context_revision",
        "translations"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/MutationRequestId"
        },
        "batch_id": {
          "$ref": "#/$defs/BatchId"
        },
        "expected_project_revision": {
          "$ref": "#/$defs/Revision"
        },
        "source_sha256": {
          "$ref": "#/$defs/SourceHash"
        },
        "context_revision": {
          "$ref": "#/$defs/Revision"
        },
        "translations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TranslatedUnit"
          }
        },
        "actor": {
          "$ref": "#/$defs/Actor"
        }
      },
      "additionalProperties": false,
      "description": "Nested units -> timed entries. Return every unit and every writable entry exactly once. Context/protected entries cannot be submitted. Source/context/revision equality, uniqueness and exact set membership are checked transactionally."
    },
    "EntryChanges": {
      "type": "object",
      "required": [],
      "properties": {
        "source_text": {
          "type": "string",
          "minLength": 1
        },
        "start_ms": {
          "$ref": "#/$defs/Milliseconds"
        },
        "end_ms": {
          "$ref": "#/$defs/Milliseconds"
        },
        "target_text": {
          "type": "string",
          "minLength": 1
        },
        "protected": {
          "type": "boolean"
        },
        "review_state": {
          "$ref": "#/$defs/ReviewState"
        },
        "clear_target": {
          "const": true
        }
      },
      "additionalProperties": false,
      "minProperties": 1,
      "dependentRequired": {
        "review_state": [
          "target_text"
        ]
      },
      "allOf": [
        {
          "if": {
            "required": [
              "clear_target"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "target_text"
                  ]
                },
                {
                  "required": [
                    "protected"
                  ]
                },
                {
                  "required": [
                    "review_state"
                  ]
                }
              ]
            }
          }
        }
      ],
      "description": "Runtime additionally enforces nonblank valid SRT text and 0 <= start_ms < end_ms. A target edit is protected by default. Source/timing edits make affected translations require review."
    },
    "EntryEditArguments": {
      "type": "object",
      "required": [
        "project_id",
        "entry_id",
        "expected_project_revision",
        "changes"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/MutationRequestId"
        },
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "entry_id": {
          "$ref": "#/$defs/EntryId"
        },
        "expected_project_revision": {
          "$ref": "#/$defs/Revision"
        },
        "changes": {
          "$ref": "#/$defs/EntryChanges"
        },
        "actor": {
          "$ref": "#/$defs/Actor"
        }
      },
      "additionalProperties": false
    },
    "EntryRestoreArguments": {
      "type": "object",
      "required": [
        "project_id",
        "change_id",
        "expected_project_revision"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/MutationRequestId"
        },
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "change_id": {
          "$ref": "#/$defs/ChangeId"
        },
        "expected_project_revision": {
          "$ref": "#/$defs/Revision"
        },
        "actor": {
          "$ref": "#/$defs/Actor"
        }
      },
      "additionalProperties": false,
      "description": "Restore the selected history change's before snapshot through a new revision/change. Restoring does not rewind project revisions or remove history."
    },
    "EntryHistoryArguments": {
      "type": "object",
      "required": [
        "project_id",
        "entry_id"
      ],
      "properties": {
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "entry_id": {
          "$ref": "#/$defs/EntryId"
        }
      },
      "additionalProperties": false
    },
    "JobActivityArguments": {
      "type": "object",
      "required": [
        "project_id",
        "agent_label",
        "phase"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/MutationRequestId"
        },
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "agent_label": {
          "$ref": "#/$defs/Actor"
        },
        "phase": {
          "$ref": "#/$defs/ActivityPhase"
        },
        "batch_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/BatchId"
            },
            {
              "type": "null"
            }
          ]
        },
        "ttl_seconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 600,
          "default": 120
        }
      },
      "additionalProperties": false
    },
    "JobControlArguments": {
      "type": "object",
      "required": [
        "project_id",
        "action"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/MutationRequestId"
        },
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "action": {
          "enum": [
            "pause",
            "resume",
            "cancel"
          ]
        }
      },
      "additionalProperties": false
    },
    "FormattingProfile": {
      "type": "object",
      "required": [
        "plain",
        "runs",
        "open_after",
        "errors"
      ],
      "properties": {
        "plain": {
          "type": "string"
        },
        "runs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "start",
              "end",
              "styles"
            ],
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 0
              },
              "styles": {
                "type": "array",
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            },
            "additionalProperties": false
          }
        },
        "open_after": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "description": "Source formatting hints. Each style tuple is [tag_name, [[attribute_name, attribute_value], ...]]. Runs use offsets within plain; hints do not authorize changing scope."
    },
    "TranslationUnit": {
      "type": "object",
